# انسخ هذا الملف إلى .env.local وضع المفاتيح الحقيقية (لا يُرفع .env.local إلى Git أبداً)

# ElevenLabs — تحويل النص إلى صوت + توليد الموسيقى (Eleven Music)
ELEVENLABS_API_KEY=
# اختياري: نموذج TTS (الافتراضي eleven_multilingual_v2)
# ELEVENLABS_MODEL_ID=eleven_v3

# Google Gemini — مساعد كتابة الكلمات (بديل Claude) + موديلات Lyria 3 لتوليد الموسيقى
GEMINI_API_KEY=
# اختياري: نموذج مساعد الكلمات (الافتراضي gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# اختياري: نموذج توليد الموسيقى (الافتراضي lyria-3-pro-preview) — يتطلب تفعيل الفوترة في Google Cloud
# LYRIA_MODEL=lyria-3-pro-preview
# اختياري: فرض مزوّد موسيقى بعينه (lyria أو elevenlabs). الافتراضي: Lyria مع رجوع تلقائي لـ Eleven Music
# MUSIC_PROVIDER=lyria

# Anthropic Claude — مساعد كتابة الكلمات والمقامات (المرحلة 2)
ANTHROPIC_API_KEY=
# اختياري: نموذج المساعد (الافتراضي claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Azure Speech — أصوات اللهجات العربية (اختياري)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Supabase — الحسابات والمكتبة وقاعدة البيانات (المرحلة 4)
# أنشئ مشروعاً على supabase.com ونفّذ supabase/schema.sql في محرر SQL ثم ضع القيم هنا
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح الخدمة — سرّي جداً، يتجاوز كل سياسات الأمان: للخادم فقط (Vercel)،
# ويفعّل المهام الدائمة وتحديد معدل الاستخدام الذرّي وسجل ملكية الأصوات
SUPABASE_SERVICE_ROLE_KEY=

# لوحة مالك النظام (/admin) — بُرُد المالكين مفصولة بفواصل.
# بلا ضبط هذا المتغير لا يوجد مالك إطلاقاً واللوحة مغلقة للجميع (افتراضي آمن).
# يجب أن يكون البريد مسجّلاً في Supabase Auth ليتمكن صاحبه من الدخول.
OWNER_EMAILS=

# تطبيق Meta (فيسبوك) — ربط الصفحات والنشر عليها من المكتبة.
# التكامل مبنيّ وجاهز؛ يكفي وضع هذين المفتاحين ليظهر في الموقع.
# خطوات إنشاء التطبيق والحصول على القيم في docs/facebook-app.md
# App Secret سرّي: للخادم وحده ولا يصل المتصفح إطلاقاً
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# اختياري: رابط الرجوع إن اختلف عن <أصل الموقع>/api/facebook/callback
# FACEBOOK_REDIRECT_URI=https://example.com/api/facebook/callback
# اختياري: نسخة Graph API (الافتراضي v25.0 — أحدث نسخة مدعومة وقت البناء)
# FACEBOOK_GRAPH_VERSION=v25.0
# اختياري: سرّ تشفير رموز الصفحات المخزّنة (الافتراضي: سرّ التطبيق نفسه).
# ضبطه منفصلاً يعني أن تدوير سرّ التطبيق لا يُبطل الصفحات المربوطة.
# FACEBOOK_TOKEN_SECRET=

# أصل الموقع كما يراه الزائر — يُبنى عليه رابط المشاركة العامة ووسوم OG.
# بدونه يُستنتج من ترويسات الطلب (يكفي عادةً على Vercel).
# NEXT_PUBLIC_SITE_URL=https://sound.feedsnews.net

# WhatsApp Cloud API — رسائل واتساب حقيقية من زبائنك وإليهم (/whatsapp)
# الخطوات كاملة في docs/whatsapp-setup.md
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# كلمة سرية من اختيارك، تكتبها هنا وفي إعداد الـ webhook لدى Meta
WHATSAPP_VERIFY_TOKEN=
# سرّ تطبيق Meta — به يُتحقق من توقيع كل حمولة واردة (يعود لـ FACEBOOK_APP_SECRET)
# WHATSAPP_APP_SECRET=
# اختياري: نسخة Graph API (الافتراضي v23.0)
# WHATSAPP_API_VERSION=v23.0

# اختياري: ضبط الكلفة التقديرية لكل حدث بالدولار كما تظهر في لوحة المالك
# (الافتراضيات مبنية على أسعار المزوّدين في PLAN.md)
# COST_TTS=0.02
# COST_SONGS=0.09
# COST_DRAMA=0.02
# COST_AUDIOBOOK=0.02

# اختياري: حدود الاستخدام بالساعة لغير المسجلين (المسجلون يحصلون على أضعافها)
# RATE_LIMIT_TTS=20
# RATE_LIMIT_SONGS=6
# RATE_LIMIT_LYRICS=30
# RATE_LIMIT_STT=8
# RATE_LIMIT_STS=6
# RATE_LIMIT_CLONE=3
# RATE_LIMIT_DESIGN=5
# RATE_LIMIT_PRONUNCIATION=30
# RATE_LIMIT_ENHANCE=30
# RATE_LIMIT_IMAGE_BRIEF=10
# RATE_LIMIT_DRAMA=5
# الكتب الصوتية: الحد لكل فصل لا لكل كتاب، فيُضبط أعلى من بقية المسارات
# RATE_LIMIT_AUDIOBOOK=40
# RATE_LIMIT_FACEBOOK=10
# RATE_LIMIT_WHATSAPP=120
# RATE_LIMIT_SIGNED_IN_MULTIPLIER=3
