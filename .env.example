# انسخ هذا الملف إلى .env.local وضع المفاتيح الحقيقية (لا يُرفع .env.local إلى Git أبداً)

# ElevenLabs — تحويل النص إلى صوت + توليد الموسيقى (Eleven Music)
ELEVENLABS_API_KEY=
# اختياري: نموذج TTS (الافتراضي eleven_multilingual_v2)
# ELEVENLABS_MODEL_ID=eleven_v3

# Google Gemini — مساعد كتابة الكلمات (بديل Claude) + موديلات Lyria 3 لتوليد الموسيقى
GEMINI_API_KEY=
# اختياري: نموذج مساعد الكلمات (الافتراضي gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# اختياري: نموذج توليد الموسيقى (الافتراضي lyria-3-pro-preview) — يتطلب تفعيل الفوترة في Google Cloud
# LYRIA_MODEL=lyria-3-pro-preview
# اختياري: فرض مزوّد موسيقى بعينه (lyria أو elevenlabs). الافتراضي: Lyria مع رجوع تلقائي لـ Eleven Music
# MUSIC_PROVIDER=lyria

# Anthropic Claude — مساعد كتابة الكلمات والمقامات (المرحلة 2)
ANTHROPIC_API_KEY=
# اختياري: نموذج المساعد (الافتراضي claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Azure Speech — أصوات اللهجات العربية (اختياري)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Supabase — الحسابات والمكتبة السحابية (المرحلة 4)
# أنشئ مشروعاً على supabase.com ونفّذ supabase/schema.sql في محرر SQL ثم ضع القيم هنا
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح الخدمة (سرّي — للخادم فقط، لا يصل للمتصفح أبداً):
# يفعّل المهام الدائمة وتحديد معدل الاستخدام والحفظ الخادمي — إلزامي للنشر على Vercel
SUPABASE_SERVICE_ROLE_KEY=

# اختياري: حدود الاستخدام بالساعة لغير المسجلين (المسجلون يحصلون على أضعافها)
# RATE_LIMIT_TTS=10
# RATE_LIMIT_SONGS=6
# RATE_LIMIT_LYRICS=12
# RATE_LIMIT_STT=8
# RATE_LIMIT_STS=6
# RATE_LIMIT_CLONE=2
# RATE_LIMIT_SIGNED_IN_MULTIPLIER=3
