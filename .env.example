# انسخ هذا الملف إلى .env.local وضع المفاتيح الحقيقية (لا يُرفع .env.local إلى Git أبداً)

# ElevenLabs — تحويل النص إلى صوت + توليد الموسيقى (Eleven Music)
ELEVENLABS_API_KEY=
# اختياري: نموذج TTS (الافتراضي eleven_multilingual_v2)
# ELEVENLABS_MODEL_ID=eleven_v3

# Google Gemini — مساعد كتابة الكلمات (بديل Claude) + موديلات Lyria 3 لتوليد الموسيقى
GEMINI_API_KEY=
# اختياري: نموذج مساعد الكلمات (الافتراضي gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# اختياري: نموذج توليد الموسيقى (الافتراضي lyria-3-pro-preview) — يتطلب تفعيل الفوترة في Google Cloud
# LYRIA_MODEL=lyria-3-pro-preview
# اختياري: نموذج توليد صور أغلفة الألبومات (الافتراضي gemini-3.1-flash-image)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# اختياري: فرض مزوّد موسيقى بعينه (lyria أو elevenlabs). الافتراضي: Lyria مع رجوع تلقائي لـ Eleven Music
# MUSIC_PROVIDER=lyria

# Anthropic Claude — مساعد كتابة الكلمات والمقامات (المرحلة 2)
ANTHROPIC_API_KEY=
# اختياري: نموذج المساعد (الافتراضي claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Azure Speech — أصوات اللهجات العربية (اختياري)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Supabase — الحسابات والمكتبة وقاعدة البيانات (المرحلة 4)
# أنشئ مشروعاً على supabase.com ونفّذ supabase/schema.sql في محرر SQL ثم ضع القيم هنا
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح الخدمة — سرّي جداً، يتجاوز كل سياسات الأمان: للخادم فقط (Vercel)،
# ويفعّل المهام الدائمة وتحديد معدل الاستخدام الذرّي وسجل ملكية الأصوات
SUPABASE_SERVICE_ROLE_KEY=

# لوحة مالك النظام (/admin) — بُرُد المالكين مفصولة بفواصل.
# بلا ضبط هذا المتغير لا يوجد مالك إطلاقاً واللوحة مغلقة للجميع (افتراضي آمن).
# يجب أن يكون البريد مسجّلاً في Supabase Auth ليتمكن صاحبه من الدخول.
OWNER_EMAILS=

# اختياري: ضبط الكلفة التقديرية لكل حدث بالدولار كما تظهر في لوحة المالك
# (الافتراضيات مبنية على أسعار المزوّدين في PLAN.md)
# COST_TTS=0.02
# COST_SONGS=0.09
# COST_DRAMA=0.02

# اختياري: حدود الاستخدام بالساعة لغير المسجلين (المسجلون يحصلون على أضعافها)
# RATE_LIMIT_TTS=20
# RATE_LIMIT_SONGS=6
# RATE_LIMIT_LYRICS=30
# RATE_LIMIT_STT=8
# RATE_LIMIT_STS=6
# RATE_LIMIT_CLONE=3
# RATE_LIMIT_DESIGN=5
# RATE_LIMIT_PRONUNCIATION=30
# RATE_LIMIT_ENHANCE=30
# RATE_LIMIT_IMAGE_BRIEF=10
# RATE_LIMIT_DRAMA=5
# RATE_LIMIT_COVER=8
# RATE_LIMIT_SIGNALS=120
# RATE_LIMIT_PROMPTS=20
# RATE_LIMIT_SIGNED_IN_MULTIPLIER=3

# مفتاح إطفاء عقل المنصة (كل حلقات التعلم) عند الحاجة للتشخيص
# BRAIN_DISABLED=1
